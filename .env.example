# Copy to .env and fill in. Never commit .env.
# The chat model is configured OpenAI-compatibly. Default: OpenAI gpt-4o.
# To use an OpenAI-compatible gateway (e.g. OpenCode Go) instead, set:
#   OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
#   OPENAI_MODEL=deepseek-v4.1-flash
# and put the provider's API key in OPENAI_API_KEY. A custom base URL also
# sends a stable x-opencode-session header and User-Agent per process.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Embeddings: "openai" (default, text-embedding-3-small via OPENAI_API_KEY) or
# "local" (Chroma's built-in model, no API key, stored in a _local collection).
# Chat gateways usually offer no embeddings API, so use "local" with them.
EMBEDDINGS_PROVIDER=openai

# Optional: static bearer token for the API. Empty = open access (local dev only).
INCIDENT_API_TOKEN=

# Optional: API base URL used by the Streamlit UI.
INCIDENT_API_URL=http://localhost:8000

# Optional: where ChromaDB stores the current-incident evidence index.
CHROMA_PERSIST_DIR=./chroma_db

# Optional: Hindsight long-term operational memory. Memory is disabled unless
# both HINDSIGHT_API_URL and HINDSIGHT_BANK_ID are set.
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=

# Optional: SQLite files for human approvals and paused workflows (default var/).
# They hold sensitive incident/workflow state: keep them out of Git (var/ is ignored).
APPROVAL_DB_PATH=var/approvals.sqlite3
CHECKPOINT_DB_PATH=var/checkpoints.sqlite3

# Development/demo only: enables POST /approvals (direct approval creation). Leave unset.
ENABLE_DEV_APPROVAL_ENDPOINT=

# Optional: read-only inspection of ONE target repository (absolute path).
# Unset = no repository inspection. There is no default target.
TARGET_REPO_PATH=
TARGET_REPO_ID=target
# Optional inspection limits (defaults shown).
REPO_INSPECT_MAX_FILE_BYTES=262144
REPO_INSPECT_MAX_LINES=400
REPO_INSPECT_MAX_LIST_ENTRIES=500
REPO_INSPECT_MAX_OUTPUT_CHARS=60000
